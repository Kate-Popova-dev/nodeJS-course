extends layout

block content
    h1 Login Page
    p Увійдіть до свого облікового запису.
    form#formElem
        .mb-3
            label.form-label(for="email") Email address
            input.form-control(type="email" name="email" id="email" placeholder="example@email.com")
        .mb-3
            label.form-label(for="password") Password
            input.form-control(type="password" name="password" id="password" placeholder="Введіть пароль")
        button.btn.btn-primary(type="submit") Login
            script.
                const formElem = document.querySelector('#formElem');
                formElem.onsubmit = async (e) => {
                    e.preventDefault();
                    let response = await fetch('/jwt/login', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(Object.fromEntries(new FormData(formElem)))
                    });
                    let result = await response.json();
                    console.log('result: ', result)
                };