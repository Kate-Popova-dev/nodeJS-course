extends layout

block content
    h1= title
    p= "P text"
    if todoList.length > 1
        ul
            each toDo in todoList
                if(toDo)
                    li status: #{toDo.status ? toDo.status : 'new'}, text #{toDo.text}
    else
        p No Todo items
    div
        form#formElem(action='/todo/items', method='POST')
            input(name='text' type='text' value='Todo')
            input(type='submit' value='Send')


